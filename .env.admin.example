# Admin-only credentials for the Alfred Supabase project.
#
# Copy to .env.admin.local (gitignored) and fill in. NEVER put these in
# .env or web/.env.local — those are bundled and shipped to the client.
#
# Get the secret key from:
#   Project Settings -> API Keys -> Secret keys  (starts sb_secret_)
#   https://supabase.com/dashboard/project/tmljizvoueikwrjtdjzs/settings/api-keys
#
# The legacy service_role JWT does NOT work on this project; legacy keys were
# disabled 2026-06-05.

SUPABASE_URL=https://tmljizvoueikwrjtdjzs.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
